# ──────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in YOUR OWN values, then run ./setup.sh
#  No real keys ship in this repo — you supply your own. `.env` is gitignored.
# ──────────────────────────────────────────────────────────────────────────

# 21st.dev Magic MCP — required only if you want the `magic` MCP server.
# Get a key: https://21st.dev  →  account/API keys
MAGIC_API_KEY=

# Waveforge MCP (LOCAL TOOL) — absolute path to the python inside Waveforge's venv.
# Only needed if you use Waveforge. Example: /home/you/dev/waveforge/.venv/bin/python
# Leave blank to skip registering the waveforge MCP.
WAVEFORGE_VENV_PYTHON=

# OPTIONAL — Claude Code web "verifier" auto-login (settings.json env block in the
# source workspace). Most people do NOT need this. Fill in only if you know you do.
# CLAUDE_VERIFIER_EMAIL=
# CLAUDE_VERIFIER_PASSWORD=
